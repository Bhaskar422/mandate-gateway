# Public base URL of this app. PayPal redirects and webhooks need it; use your tunnel/hosted URL when not on localhost.
APP_URL=http://localhost:3000
DATABASE_URL=postgres://postgres@localhost:54329/mandate

# Anthropic: mandate compiler and product classifier
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5

# PayPal sandbox: the gateway's REST app (Vault must be enabled on it)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# direct = the merchant is the payee on each order (default). platform = the gateway's account collects.
# PAYPAL_PAYEE_MODE=direct

# Demo store "Stride" (verified): its own sandbox business account and REST app
PAYPAL_STORE_STRIDE_MERCHANT_ID=
PAYPAL_STORE_STRIDE_EMAIL=
PAYPAL_STORE_STRIDE_CLIENT_ID=
PAYPAL_STORE_STRIDE_CLIENT_SECRET=
PAYPAL_STORE_STRIDE_WEBHOOK_ID=

# Demo store "Kickz" (not verified): never gets paid, so a payee is optional
PAYPAL_STORE_KICKZ_MERCHANT_ID=
PAYPAL_STORE_KICKZ_EMAIL=

# Ed25519 private key (PKCS8 PEM, base64) that signs the evidence ledger. Generate with: pnpm keygen
LEDGER_SIGNING_KEY=
