# Public base URL of this app. PayPal redirects and webhooks need it; use your tunnel/hosted URL when not on localhost.
APP_URL=http://localhost:3000
DATABASE_URL=postgres://postgres@localhost:54329/mandate

# Anthropic: mandate compiler and product classifier
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
# Opens the operator review page (/operator), where stores are granted verified status. At least 16 characters.
# OPERATOR_KEY=
# The built-in shopping assistant uses LLM_MODEL unless you name another model here.
# ASSISTANT_MODEL=claude-opus-5-5
# Messages each user may send the built-in assistant per day (it runs on your model key).
# ASSISTANT_DAILY_LIMIT=40

# PayPal sandbox: the gateway's REST app (Vault must be enabled on it)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# direct = the merchant is the payee on each order (default). platform = the gateway's account collects.
# PAYPAL_PAYEE_MODE=direct

# Demo store "Stride" (verified): its own sandbox business account and REST app
PAYPAL_STORE_STRIDE_MERCHANT_ID=
PAYPAL_STORE_STRIDE_EMAIL=
PAYPAL_STORE_STRIDE_CLIENT_ID=
PAYPAL_STORE_STRIDE_CLIENT_SECRET=
PAYPAL_STORE_STRIDE_WEBHOOK_ID=

# Demo store "Kickz" (not verified): never gets paid, so a payee is optional
PAYPAL_STORE_KICKZ_MERCHANT_ID=
PAYPAL_STORE_KICKZ_EMAIL=

# Ed25519 private key (PKCS8 PEM, base64) that signs the evidence ledger. Generate with: pnpm keygen
LEDGER_SIGNING_KEY=

# Demo store "Peak" (onboards itself by URL). Without its own values it borrows Stride's sandbox account.
# PAYPAL_STORE_PEAK_MERCHANT_ID=
# PAYPAL_STORE_PEAK_EMAIL=
# PAYPAL_STORE_PEAK_CLIENT_ID=
# PAYPAL_STORE_PEAK_CLIENT_SECRET=

# Only for agent-tests/ (the cross-framework agent suite). Leave unset to skip those frameworks.
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# AGENT_TESTS_OPENAI_MODEL=gpt-5-mini
# AGENT_TESTS_GOOGLE_MODEL=gemini-flash-lite-latest
